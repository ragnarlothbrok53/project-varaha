---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Gateway Access - Varaha">
  <main class="min-h-screen flex items-center justify-center px-4">
    <div class="max-w-md w-full">
      <div class="glass-purple rounded-2xl p-8 shadow-2xl">
        <div class="text-center mb-8">
          <h1 class="text-3xl font-bold text-white mb-2">Gateway Access</h1>
          <p class="text-gray-300">Enter your credentials to access the control plane</p>
        </div>
        
        <form class="space-y-6" id="loginForm">
          <div>
            <label for="email" class="block text-sm font-medium text-gray-300 mb-2">
              Email
            </label>
            <input
              id="email"
              name="email"
              type="email"
              required
              placeholder="admin@varaha.ai"
              class="w-full px-4 py-3 bg-white/5 border border-white/10 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-purple focus:border-transparent backdrop-blur-sm"
            />
          </div>
          <div>
            <label for="password" class="block text-sm font-medium text-gray-300 mb-2">
              Password
            </label>
            <input
              id="password"
              name="password"
              type="password"
              required
              placeholder="••••••••"
              class="w-full px-4 py-3 bg-white/5 border border-white/10 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-purple focus:border-transparent backdrop-blur-sm"
            />
          </div>

          <button
            type="submit"
            class="w-full px-6 py-3 bg-gradient-to-r from-brand-purple to-brand-blue text-white rounded-lg font-medium hover:from-brand-purple/90 hover:to-brand-blue/90 transition-all duration-200 shadow-lg"
          >
            Access Gateway
          </button>

          <div id="error" class="hidden text-red-400 text-sm text-center bg-red-500/10 border border-red-500/20 rounded-lg p-3"></div>
        </form>
      </div>
    </div>
  </main>

  <script>
    import { authService } from '../lib/auth.ts';

    document.getElementById('loginForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const email = (document.getElementById('email') as HTMLInputElement).value;
      const password = (document.getElementById('password') as HTMLInputElement).value;
      const errorDiv = document.getElementById('error');
      const button = e.target.querySelector('button');
      
      button.disabled = true;
      button.textContent = 'Verifying...';
      
      try {
        const success = await authService.login(email, password);
        if (success) {
          window.location.href = '/dashboard';
        } else {
          errorDiv.textContent = 'Invalid email or password. Please try again.';
          errorDiv.classList.remove('hidden');
        }
      } catch (error) {
        errorDiv.textContent = 'Connection error. Please ensure the backend is running.';
        errorDiv.classList.remove('hidden');
      } finally {
        button.disabled = false;
        button.textContent = 'Access Gateway';
      }
    });
  </script>
</Layout>
