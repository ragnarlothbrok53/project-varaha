---
import Layout from "../layouts/Layout.astro";
import { authService } from "../lib/auth.ts";

const user = authService.getUser();
---

<Layout title="API Documentation - Varaha">
  <nav class="border-b border-white/10 glass backdrop-blur-md">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex h-16 items-center justify-between">
        <div class="flex items-center space-x-8">
          <a href="/" class="flex items-center space-x-2 relative">
            <img
              src="/mandala2.svg"
              alt="Varaha Logo"
              class="w-10 h-10 object-contain scale-110 opacity-40 animate-spin animate-duration-1000"
              style="filter: brightness(0) invert(1) sepia(1) saturate(2) hue-rotate(15deg) brightness(1.2);"
            />
            <span
              class="text-2xl font-semibold text-white tracking-widest transform -translate-x-5"
              >varaha<span class="text-brand-purple">.ai</span></span
            >
          </a>
          <div class="hidden md:flex space-x-6">
            <a href="/docs" class="text-white font-medium">API Docs</a>
            <a
              href="/api-test"
              class="text-gray-300 hover:text-white transition-colors"
              >API Test</a
            >
          </div>
        </div>
        <div class="flex items-center space-x-4">
          <button
            id="logoutBtn"
            class="px-4 py-2 text-sm border border-white/20 rounded-lg hover:bg-white/10 transition-colors text-white"
          >
            Logout
          </button>
        </div>
      </div>
    </div>
  </nav>

  <!-- HEADER -->
  <div class="container mx-auto px-4 py-6 text-center">
    <h2 class="text-3xl font-bold text-white mb-4">
      Interactive API Documentation
    </h2>
    <p class="text-gray-300">Test endpoints directly</p>
  </div>

  <!-- TABS -->
  <div class="container mx-auto px-4 mb-8">
    <div class="flex space-x-4 border-b border-white/10">
      <button
        onclick="showTab('chat')"
        id="chatTab"
        class="px-4 py-2 text-white font-medium border-b-2 border-brand-purple transition-colors"
      >
        Chat Completions
      </button>
      <button
        onclick="showTab('tasks')"
        id="tasksTab"
        class="px-4 py-2 text-gray-300 hover:text-white transition-colors"
      >
        Tasks
      </button>
    </div>
  </div>

  <main class="py-8 font-sans">
    <div class="container mx-auto px-4 max-w-5xl">
      <!-- CHAT COMPLETIONS TAB -->
      <div id="chatContent" class="space-y-12">
        <section>
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-2xl text-white font-sans">Chat Completions</h2>
            <button
              onclick="runChat()"
              class="px-6 py-3 bg-gradient-to-r from-brand-purple to-brand-blue text-white rounded-lg hover:from-brand-purple/90 hover:to-brand-blue/90 shadow-lg font-medium transition-all"
            >
              Test Chat
            </button>
          </div>

          <!-- Terminal UI -->
          <div
            class="glass-purple rounded-2xl p-6 shadow-2xl relative border border-white/20 font-mono text-sm mb-6"
          >
            <div class="flex items-center gap-2 mb-4 px-2">
              <div class="w-3 h-3 rounded-full bg-red-500"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
              <div class="w-3 h-3 rounded-full bg-green-500"></div>
              <span class="ml-2 text-gray-400 text-xs">chat-completions</span>
            </div>

            <div class="space-y-4 text-gray-300 px-2 pb-2">
              <!-- Endpoint Info -->
              <div class="text-brand-blue">$ POST /v1/chat/completions</div>

              <!-- Request -->
              <div>
                <div class="text-gray-400 mb-2"># Request JSON:</div>
                <pre
                  class="bg-black/50 p-3 rounded border border-white/10 text-xs">{`{
  "model": "qwen",
  "messages": [
    {
      "role": "user",
      "content": "Hello! How are you?"
    }
  ],
  "temperature": 0.7
}`}</pre>
              </div>

              <!-- Response -->
              <div>
                <div class="text-gray-400 mb-2"># Response JSON:</div>
                <pre
                  id="chatResponse"
                  class="bg-black/50 p-3 rounded border border-white/10 text-xs">Click "Test" to see response...</pre>
              </div>

              <!-- Metrics -->
              <div>
                <div class="text-gray-400 mb-2"># Metrics:</div>
                <pre
                  id="chatMetrics"
                  class="bg-black/50 p-3 rounded border border-white/10 text-xs">TTFT: --ms | Tokens: -- | TPS: --</pre>
              </div>
            </div>
          </div>

          <!-- Code Snippets -->
          <div
            class="glass-purple rounded-2xl p-6 shadow-2xl relative border border-white/20"
          >
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-lg font-semibold text-white">Code Snippets</h3>
              <div class="flex space-x-2">
                <button
                  onclick="showCodeTab('chat', 'python')"
                  id="chatPythonTab"
                  class="px-3 py-1 text-sm bg-brand-purple text-white rounded hover:bg-brand-purple/90 transition-colors"
                  >Python</button
                >
                <button
                  onclick="showCodeTab('chat', 'javascript')"
                  id="chatJsTab"
                  class="px-3 py-1 text-sm bg-gray-600 text-white rounded hover:bg-gray-700 transition-colors"
                  >JavaScript</button
                >
                <button
                  onclick="showCodeTab('chat', 'typescript')"
                  id="chatTsTab"
                  class="px-3 py-1 text-sm bg-gray-600 text-white rounded hover:bg-gray-700 transition-colors"
                  >TypeScript</button
                >
                <button
                  onclick="showCodeTab('chat', 'dart')"
                  id="chatDartTab"
                  class="px-3 py-1 text-sm bg-gray-600 text-white rounded hover:bg-gray-700 transition-colors"
                  >Dart</button
                >
              </div>
            </div>

            <!-- Python Code -->
            <div id="chatPythonCode" class="mb-6">
              <h4 class="text-md font-medium text-white mb-2">Python</h4>
              <pre
                class="bg-black/50 p-3 rounded border border-white/10 text-xs overflow-x-auto"><code class="text-green-400">{`import requests

response = requests.post(
    "http://localhost:8000/v1/chat/completions",
    headers={
        "Content-Type": "application/json",
        "Authorization": "Bearer YOUR_API_KEY"
    },
    json={
        "model": "qwen",
        "messages": [
            {
                "role": "user",
                "content": "Hello! How are you?"
            }
        ],
        "temperature": 0.7
    }
)

result = response.json()
print(result["choices"][0]["message"]["content"])`}</code></pre>
            </div>

            <!-- JavaScript Code -->
            <div id="chatJsCode" class="mb-6 hidden">
              <h4 class="text-md font-medium text-white mb-2">JavaScript</h4>
              <pre
                class="bg-black/50 p-3 rounded border border-white/10 text-xs overflow-x-auto"><code class="text-green-400">{`const response = await fetch('http://localhost:8000/v1/chat/completions', {
  method: 'POST',
  headers: {
    'Content-Type': 'application/json',
    'Authorization': 'Bearer YOUR_API_KEY'
  },
  body: JSON.stringify({
    model: 'qwen',
    messages: [
      {
        role: 'user',
        content: 'Hello! How are you?'
      }
    ],
    temperature: 0.7
  })
});

const result = await response.json();
console.log(result.choices[0].message.content);`}</code></pre>
            </div>

            <!-- TypeScript Code -->
            <div id="chatTsCode" class="mb-6 hidden">
              <h4 class="text-md font-medium text-white mb-2">TypeScript</h4>
              <pre
                class="bg-black/50 p-3 rounded border border-white/10 text-xs overflow-x-auto"><code class="text-green-400">{`interface ChatMessage {
  role: string;
  content: string;
}

interface ChatRequest {
  model: string;
  messages: ChatMessage[];
  temperature?: number;
}

const response = await fetch('http://localhost:8000/v1/chat/completions', {
  method: 'POST',
  headers: {
    'Content-Type': 'application/json',
    'Authorization': 'Bearer YOUR_API_KEY'
  },
  body: JSON.stringify({
    model: 'qwen',
    messages: [
      {
        role: 'user',
        content: 'Hello! How are you?'
      }
    ],
    temperature: 0.7
  } as ChatRequest)
});

const result = await response.json() as any;
console.log(result.choices[0].message.content);`}</code></pre>
            </div>

            <!-- Dart Code -->
            <div id="chatDartCode" class="mb-6 hidden">
              <h4 class="text-md font-medium text-white mb-2">Dart</h4>
              <pre
                class="bg-black/50 p-3 rounded border border-white/10 text-xs overflow-x-auto"><code class="text-green-400">{`import 'dart:convert';
import 'package:http/http.dart' as http;

Future<void> main() async {
  final response = await http.post(
    Uri.parse('http://localhost:8000/v1/chat/completions'),
    headers: {
      'Content-Type': 'application/json',
      'Authorization': 'Bearer YOUR_API_KEY',
    },
    body: jsonEncode({
      'model': 'qwen',
      'messages': [
        {
          'role': 'user',
          'content': 'Hello! How are you?'
        }
      ],
      'temperature': 0.7
    }),
  );

  final result = jsonDecode(response.body);
  print(result['choices'][0]['message']['content']);
}`}</code></pre>
            </div>
          </div>
        </section>
      </div>

      <!-- TASKS TAB -->
      <div id="tasksContent" class="space-y-12 hidden">
        <!-- EXTRACT -->
        <section>
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-2xl text-white font-sans">Extract</h2>
            <button
              onclick="runExtract()"
              class="px-6 py-3 bg-gradient-to-r from-brand-purple to-brand-blue text-white rounded-lg hover:from-brand-purple/90 hover:to-brand-blue/90 shadow-lg font-medium transition-all"
            >
              Test Extract
            </button>
          </div>

          <!-- Terminal UI -->
          <div
            class="glass-purple rounded-2xl p-6 shadow-2xl relative border border-white/20 font-mono text-sm mb-6"
          >
            <div class="flex items-center gap-2 mb-4 px-2">
              <div class="w-3 h-3 rounded-full bg-red-500"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
              <div class="w-3 h-3 rounded-full bg-green-500"></div>
              <span class="ml-2 text-gray-400 text-xs">extract</span>
            </div>

            <div class="space-y-4 text-gray-300 px-2 pb-2">
              <!-- Endpoint Info -->
              <div class="text-brand-blue">$ POST /v1/execute</div>

              <!-- Request -->
              <div>
                <div class="text-gray-400 mb-2"># Request JSON:</div>
                <pre
                  class="bg-black/50 p-3 rounded border border-white/10 text-xs">{`{
  "task": "extract",
  "input": {
    "text": "Invoice #42 from Bob for $500",
    "schema": {
      "invoice_number": "number",
      "customer": "string",
      "amount": "number"
    }
  }
}`}</pre>
              </div>

              <!-- Response -->
              <div>
                <div class="text-gray-400 mb-2"># Response JSON:</div>
                <pre
                  id="extractResponse"
                  class="bg-black/50 p-3 rounded border border-white/10 text-xs">Click "Test" to see response...</pre>
              </div>

              <!-- Metrics -->
              <div>
                <div class="text-gray-400 mb-2"># Metrics:</div>
                <pre
                  id="extractMetrics"
                  class="bg-black/50 p-3 rounded border border-white/10 text-xs">TTFT: --ms | Tokens: -- | TPS: --</pre>
              </div>
            </div>
          </div>

          <!-- Code Snippets -->
          <div
            class="glass-purple rounded-2xl p-6 shadow-2xl relative border border-white/20"
          >
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-lg font-semibold text-white">Code Snippets</h3>
              <div class="flex space-x-2">
                <button
                  onclick="showCodeTab('extract', 'python')"
                  id="extractPythonTab"
                  class="px-3 py-1 text-sm bg-brand-purple text-white rounded hover:bg-brand-purple/90 transition-colors"
                  >Python</button
                >
                <button
                  onclick="showCodeTab('extract', 'javascript')"
                  id="extractJsTab"
                  class="px-3 py-1 text-sm bg-gray-600 text-white rounded hover:bg-gray-700 transition-colors"
                  >JavaScript</button
                >
                <button
                  onclick="showCodeTab('extract', 'typescript')"
                  id="extractTsTab"
                  class="px-3 py-1 text-sm bg-gray-600 text-white rounded hover:bg-gray-700 transition-colors"
                  >TypeScript</button
                >
                <button
                  onclick="showCodeTab('extract', 'dart')"
                  id="extractDartTab"
                  class="px-3 py-1 text-sm bg-gray-600 text-white rounded hover:bg-gray-700 transition-colors"
                  >Dart</button
                >
              </div>
            </div>

            <!-- Python Code -->
            <div id="extractPythonCode" class="mb-6">
              <h4 class="text-md font-medium text-white mb-2">Python</h4>
              <pre
                class="bg-black/50 p-3 rounded border border-white/10 text-xs overflow-x-auto"><code class="text-green-400">{`import requests

response = requests.post(
    "http://localhost:8000/v1/execute",
    headers={
        "Content-Type": "application/json",
        "Authorization": "Bearer YOUR_API_KEY"
    },
    json={
        "task": "extract",
        "input": {
            "text": "Invoice #42 from Bob for $500",
            "schema": {
                "invoice_number": "number",
                "customer": "string",
                "amount": "number"
            }
        }
    }
)

result = response.json()
print(result["data"])`}</code></pre>
            </div>

            <!-- JavaScript Code -->
            <div id="extractJsCode" class="mb-6 hidden">
              <h4 class="text-md font-medium text-white mb-2">JavaScript</h4>
              <pre
                class="bg-black/50 p-3 rounded border border-white/10 text-xs overflow-x-auto"><code class="text-green-400">{`const response = await fetch('http://localhost:8000/v1/execute', {
  method: 'POST',
  headers: {
    'Content-Type': 'application/json',
    'Authorization': 'Bearer YOUR_API_KEY'
  },
  body: JSON.stringify({
    task: 'extract',
    input: {
      text: 'Invoice #42 from Bob for $500',
      schema: {
        invoice_number: 'number',
        customer: 'string',
        amount: 'number'
      }
    }
  })
});

const result = await response.json();
console.log(result.data);`}</code></pre>
            </div>

            <!-- TypeScript Code -->
            <div id="extractTsCode" class="mb-6 hidden">
              <h4 class="text-md font-medium text-white mb-2">TypeScript</h4>
              <pre
                class="bg-black/50 p-3 rounded border border-white/10 text-xs overflow-x-auto"><code class="text-green-400">{`interface ExtractRequest {
  task: string;
  input: {
    text: string;
    schema: {
      invoice_number: number;
      customer: string;
      amount: number;
    };
  };
}

const response = await fetch('http://localhost:8000/v1/execute', {
  method: 'POST',
  headers: {
    'Content-Type': 'application/json',
    'Authorization': 'Bearer YOUR_API_KEY'
  },
  body: JSON.stringify({
    task: 'extract',
    input: {
      text: 'Invoice #42 from Bob for $500',
      schema: {
        invoice_number: 'number',
        customer: 'string',
        amount: 'number'
      }
    }
  } as ExtractRequest)
});

const result = await response.json() as any;
console.log(result.data);`}</code></pre>
            </div>

            <!-- Dart Code -->
            <div id="extractDartCode" class="mb-6 hidden">
              <h4 class="text-md font-medium text-white mb-2">Dart</h4>
              <pre
                class="bg-black/50 p-3 rounded border border-white/10 text-xs overflow-x-auto"><code class="text-green-400">{`import 'dart:convert';
import 'package:http/http.dart' as http;

Future<void> main() async {
  final response = await http.post(
    Uri.parse('http://localhost:8000/v1/execute'),
    headers: {
      'Content-Type': 'application/json',
      'Authorization': 'Bearer YOUR_API_KEY',
    },
    body: jsonEncode({
      'task': 'extract',
      'input': {
        'text': 'Invoice #42 from Bob for \$500',
        'schema': {
          'invoice_number': 'number',
          'customer': 'string',
          'amount': 'number'
        }
      }
    }),
  );

  final result = jsonDecode(response.body);
  print(result['data']);
}`}</code></pre>
            </div>
          </div>
        </section>

        <!-- SUMMARIZE -->
        <section>
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-2xl text-white font-sans">Summarize</h2>
            <button
              onclick="runSummarize()"
              class="px-6 py-3 bg-gradient-to-r from-brand-purple to-brand-blue text-white rounded-lg hover:from-brand-purple/90 hover:to-brand-blue/90 shadow-lg font-medium transition-all"
            >
              Test Summarize
            </button>
          </div>

          <!-- Terminal UI -->
          <div
            class="glass-purple rounded-2xl p-6 shadow-2xl relative border border-white/20 font-mono text-sm mb-6"
          >
            <div class="flex items-center gap-2 mb-4 px-2">
              <div class="w-3 h-3 rounded-full bg-red-500"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
              <div class="w-3 h-3 rounded-full bg-green-500"></div>
              <span class="ml-2 text-gray-400 text-xs">summarize</span>
            </div>

            <div class="space-y-4 text-gray-300 px-2 pb-2">
              <!-- Endpoint Info -->
              <div class="text-brand-blue">$ POST /v1/execute</div>

              <!-- Request -->
              <div>
                <div class="text-gray-400 mb-2"># Request JSON:</div>
                <pre
                  class="bg-black/50 p-3 rounded border border-white/10 text-xs">{`{
  "task": "summarize",
  "input": {
    "text": "Varaha is a platform that provides structured AI APIs for developers to build reliable automation workflows."
  }
}`}</pre>
              </div>

              <!-- Response -->
              <div>
                <div class="text-gray-400 mb-2"># Response JSON:</div>
                <pre
                  id="summarizeResponse"
                  class="bg-black/50 p-3 rounded border border-white/10 text-xs">Click "Test" to see response...</pre>
              </div>

              <!-- Metrics -->
              <div>
                <div class="text-gray-400 mb-2"># Metrics:</div>
                <pre
                  id="summarizeMetrics"
                  class="bg-black/50 p-3 rounded border border-white/10 text-xs">TTFT: --ms | Tokens: -- | TPS: --</pre>
              </div>
            </div>
          </div>

          <!-- Code Snippets -->
          <div
            class="glass-purple rounded-2xl p-6 shadow-2xl relative border border-white/20"
          >
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-lg font-semibold text-white">Code Snippets</h3>
              <div class="flex space-x-2">
                <button
                  onclick="showCodeTab('summarize', 'python')"
                  id="summarizePythonTab"
                  class="px-3 py-1 text-sm bg-brand-purple text-white rounded hover:bg-brand-purple/90 transition-colors"
                  >Python</button
                >
                <button
                  onclick="showCodeTab('summarize', 'javascript')"
                  id="summarizeJsTab"
                  class="px-3 py-1 text-sm bg-gray-600 text-white rounded hover:bg-gray-700 transition-colors"
                  >JavaScript</button
                >
                <button
                  onclick="showCodeTab('summarize', 'typescript')"
                  id="summarizeTsTab"
                  class="px-3 py-1 text-sm bg-gray-600 text-white rounded hover:bg-gray-700 transition-colors"
                  >TypeScript</button
                >
                <button
                  onclick="showCodeTab('summarize', 'dart')"
                  id="summarizeDartTab"
                  class="px-3 py-1 text-sm bg-gray-600 text-white rounded hover:bg-gray-700 transition-colors"
                  >Dart</button
                >
              </div>
            </div>

            <!-- Python Code -->
            <div id="summarizePythonCode" class="mb-6">
              <h4 class="text-md font-medium text-white mb-2">Python</h4>
              <pre
                class="bg-black/50 p-3 rounded border border-white/10 text-xs overflow-x-auto"><code class="text-green-400">{`import requests

response = requests.post(
    "http://localhost:8000/v1/execute",
    headers={
        "Content-Type": "application/json",
        "Authorization": "Bearer YOUR_API_KEY"
    },
    json={
        "task": "summarize",
        "input": {
            "text": "Varaha is a platform that provides structured AI APIs for developers to build reliable automation workflows."
        }
    }
)

result = response.json()
print(result["data"])`}</code></pre>
            </div>

            <!-- JavaScript Code -->
            <div id="summarizeJsCode" class="mb-6 hidden">
              <h4 class="text-md font-medium text-white mb-2">JavaScript</h4>
              <pre
                class="bg-black/50 p-3 rounded border border-white/10 text-xs overflow-x-auto"><code class="text-green-400">{`const response = await fetch('http://localhost:8000/v1/execute', {
  method: 'POST',
  headers: {
    'Content-Type': 'application/json',
    'Authorization': 'Bearer YOUR_API_KEY'
  },
  body: JSON.stringify({
    task: 'summarize',
    input: {
      text: 'Varaha is a platform that provides structured AI APIs for developers to build reliable automation workflows.'
    }
  })
});

const result = await response.json();
console.log(result.data);`}</code></pre>
            </div>

            <!-- TypeScript Code -->
            <div id="summarizeTsCode" class="mb-6 hidden">
              <h4 class="text-md font-medium text-white mb-2">TypeScript</h4>
              <pre
                class="bg-black/50 p-3 rounded border border-white/10 text-xs overflow-x-auto"><code class="text-green-400">{`interface SummarizeRequest {
  task: string;
  input: {
    text: string;
  };
}

const response = await fetch('http://localhost:8000/v1/execute', {
  method: 'POST',
  headers: {
    'Content-Type': 'application/json',
    'Authorization': 'Bearer YOUR_API_KEY'
  },
  body: JSON.stringify({
    task: 'summarize',
    input: {
      text: 'Varaha is a platform that provides structured AI APIs for developers to build reliable automation workflows.'
    }
  } as SummarizeRequest)
});

const result = await response.json() as any;
console.log(result.data);`}</code></pre>
            </div>

            <!-- Dart Code -->
            <div id="summarizeDartCode" class="mb-6 hidden">
              <h4 class="text-md font-medium text-white mb-2">Dart</h4>
              <pre
                class="bg-black/50 p-3 rounded border border-white/10 text-xs overflow-x-auto"><code class="text-green-400">{`import 'dart:convert';
import 'package:http/http.dart' as http;

Future<void> main() async {
  final response = await http.post(
    Uri.parse('http://localhost:8000/v1/execute'),
    headers: {
      'Content-Type': 'application/json',
      'Authorization': 'Bearer YOUR_API_KEY',
    },
    body: jsonEncode({
      'task': 'summarize',
      'input': {
        'text': 'Varaha is a platform that provides structured AI APIs for developers to build reliable automation workflows.'
      }
    }),
  );

  final result = jsonDecode(response.body);
  print(result['data']);
}`}</code></pre>
            </div>
          </div>
        </section>

        <!-- CLASSIFY -->
        <section>
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-2xl text-white font-sans">Classify</h2>
            <button
              onclick="runClassify()"
              class="px-6 py-3 bg-gradient-to-r from-brand-purple to-brand-blue text-white rounded-lg hover:from-brand-purple/90 hover:to-brand-blue/90 shadow-lg font-medium transition-all"
            >
              Test Classify
            </button>
          </div>

