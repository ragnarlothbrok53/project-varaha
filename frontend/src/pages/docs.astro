  <script>
    import { authService } from "../lib/auth.ts";

    // auth guard
    if (!authService.isAuthenticated()) {
      window.location.href = "/login";
    }

    // Logout handler
    const logoutBtn = document.getElementById("logoutBtn");
    if (logoutBtn) {
      logoutBtn.addEventListener("click", () => {
        authService.logout();
        window.location.reload();
      });
    }

    let apiKey = "vk_live_test_key";

    async function init() {
      try {
        const res = await authService.fetchWithAuth(
          "http://localhost:8000/v1/admin/keys",
        );
        const data = await res.json();
        if (data.keys?.length) {
          apiKey = data.keys[0].key;
        }
      } catch {}
    }

    function showTab(tab) {
      const chatContent = document.getElementById("chatContent");
      const tasksContent = document.getElementById("tasksContent");

      const chatTab = document.getElementById("chatTab");
      const tasksTab = document.getElementById("tasksTab");

      if (tab === "chat") {
        chatContent.classList.remove("hidden");
        tasksContent.classList.add("hidden");

        chatTab.classList.add("text-white", "border-brand-purple");
        chatTab.classList.remove("text-gray-300");

        tasksTab.classList.remove("text-white", "border-brand-purple");
        tasksTab.classList.add("text-gray-300");
      } else {
        chatContent.classList.add("hidden");
        tasksContent.classList.remove("hidden");

        tasksTab.classList.add("text-white", "border-brand-purple");
        tasksTab.classList.remove("text-gray-300");

        chatTab.classList.remove("text-white", "border-brand-purple");
        chatTab.classList.add("text-gray-300");
      }
    }
    function capitalize(str) {
      return str.charAt(0).toUpperCase() + str.slice(1);
    }

    function capitalizeShort(str) {
      if (str === "javascript") return "Js";
      if (str === "typescript") return "Ts";
      if (str === "dart") return "Dart";
      return "Python";
    }
    function showCodeTab(section, lang) {
      const langs = ["python", "javascript", "typescript", "dart"];

      langs.forEach((l) => {
        const code = document.getElementById(`${section}${capitalize(l)}Code`);
        const tab = document.getElementById(
          `${section}${capitalizeShort(l)}Tab`,
        );

        if (code) code.classList.add("hidden");
        if (tab) tab.classList.remove("bg-brand-purple");
      });

      const activeCode = document.getElementById(
        `${section}${capitalize(lang)}Code`,
      );
      const activeTab = document.getElementById(
        `${section}${capitalizeShort(lang)}Tab`,
      );

      if (activeCode) activeCode.classList.remove("hidden");
      if (activeTab) activeTab.classList.add("bg-brand-purple");
    }

    async function callAPI(body: any) {
      const res = await fetch("http://localhost:8000/v1/execute", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Authorization: `Bearer ${apiKey}`,
        },
        body: JSON.stringify(body),
      });

      return await res.json();
    }
    async function runChat() {
      const responseEl = document.getElementById("chatResponse");
      const metricsEl = document.getElementById("chatMetrics");

      if (!responseEl || !metricsEl) return;

      responseEl.textContent = "Loading...";
      metricsEl.textContent = "TTFT: --ms | Tokens: -- | TPS: --";

      try {
        const res = await fetch("http://localhost:8000/v1/chat/completions", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Authorization: `Bearer ${apiKey}`,
          },
          body: JSON.stringify({
            model: "qwen",
            messages: [{ role: "user", content: "Hello! How are you?" }],
            temperature: 0.7,
          }),
        });

        const data = await res.json();
        responseEl.textContent = JSON.stringify(data, null, 2);

        // Update metrics if available
        if (data.usage) {
          metricsEl.textContent = `TTFT: --ms | Tokens: ${data.usage.total_tokens} | TPS: --`;
        }
      } catch {
        responseEl.textContent = "Error: Failed to connect to API";
      }
    }

    async function runExtract() {
      const responseEl = document.getElementById("extractResponse");
      const metricsEl = document.getElementById("extractMetrics");

      if (!responseEl || !metricsEl) return;

      responseEl.textContent = "Loading...";
      metricsEl.textContent = "TTFT: --ms | Tokens: -- | TPS: --";

      try {
        const data = await callAPI({
          task: "extract",
          input: {
            text: "Invoice #42 from Bob for $500",
            schema: {
              invoice_number: "number",
              customer: "string",
              amount: "number",
            },
          },
        });

        responseEl.textContent = JSON.stringify(data, null, 2);

        // Update metrics if available
        if (data.metrics) {
          const totalTokens =
            (data.metrics.input_tokens || 0) +
            (data.metrics.output_tokens || 0);
          metricsEl.textContent = `TTFT: ${data.metrics.ttft_ms || "--"}ms | Tokens: ${totalTokens} | TPS: ${data.metrics.tps || "--"}`;
        }
      } catch {
        responseEl.textContent = "Error: Failed to connect to API";
      }
    }

    async function runSummarize() {
      const responseEl = document.getElementById("summarizeResponse");
      const metricsEl = document.getElementById("summarizeMetrics");

      if (!responseEl || !metricsEl) return;

      responseEl.textContent = "Loading...";
      metricsEl.textContent = "TTFT: --ms | Tokens: -- | TPS: --";

      try {
        const data = await callAPI({
          task: "summarize",
          input: {
            text: "Varaha is a platform that provides structured AI APIs for developers to build reliable automation workflows.",
          },
        });

        responseEl.textContent = JSON.stringify(data, null, 2);

        // Update metrics if available
        if (data.metrics) {
          const totalTokens =
            (data.metrics.input_tokens || 0) +
            (data.metrics.output_tokens || 0);
          metricsEl.textContent = `TTFT: ${data.metrics.ttft_ms || "--"}ms | Tokens: ${totalTokens} | TPS: ${data.metrics.tps || "--"}`;
        }
      } catch {
        responseEl.textContent = "Error: Failed to connect to API";
      }
    }

    async function runClassify() {
      const responseEl = document.getElementById("classifyResponse");
      const metricsEl = document.getElementById("classifyMetrics");

      if (!responseEl || !metricsEl) return;

      responseEl.textContent = "Loading...";
      metricsEl.textContent = "TTFT: --ms | Tokens: -- | TPS: --";

      try {
        const data = await callAPI({
          task: "classify",
          input: {
            text: "I want a refund immediately",
            labels: ["billing", "support", "general"],
          },
        });

        responseEl.textContent = JSON.stringify(data, null, 2);

        // Update metrics if available
        if (data.metrics) {
          const totalTokens =
            (data.metrics.input_tokens || 0) +
            (data.metrics.output_tokens || 0);
          metricsEl.textContent = `TTFT: ${data.metrics.ttft_ms || "--"}ms | Tokens: ${totalTokens} | TPS: ${data.metrics.tps || "--"}`;
        }
      } catch {
        responseEl.textContent = "Error: Failed to connect to API";
      }
    }

    async function runRewrite() {
      const responseEl = document.getElementById("rewriteResponse");
      const metricsEl = document.getElementById("rewriteMetrics");

      if (!responseEl || !metricsEl) return;

      responseEl.textContent = "Loading...";
      metricsEl.textContent = "TTFT: --ms | Tokens: -- | TPS: --";

      try {
        const data = await callAPI({
          task: "rewrite",
          input: {
            text: "pls fix this asap bro",
            tone: "professional",
          },
        });

        responseEl.textContent = JSON.stringify(data, null, 2);

        // Update metrics if available
        if (data.metrics) {
          const totalTokens =
            (data.metrics.input_tokens || 0) +
            (data.metrics.output_tokens || 0);
          metricsEl.textContent = `TTFT: ${data.metrics.ttft_ms || "--"}ms | Tokens: ${totalTokens} | TPS: ${data.metrics.tps || "--"}`;
        }
      } catch {
        responseEl.textContent = "Error: Failed to connect to API";
      }
    }

    init();

    (window as any).runExtract = runExtract;
    (window as any).runSummarize = runSummarize;
    (window as any).runClassify = runClassify;
    (window as any).runRewrite = runRewrite;
    (window as any).runChat = runChat;
    (window as any).showTab = showTab;
    (window as any).showCodeTab = showCodeTab;
  </script>
