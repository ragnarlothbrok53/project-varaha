---
import Layout from '../layouts/Layout.astro'
import { authService } from '../lib/auth.ts'
const user = authService.getUser()
---

<Layout title="Documentation - Varaha">
  <nav class="border-b border-white/10 glass backdrop-blur-md">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex h-16 items-center justify-between">
        <div class="flex items-center space-x-8">
          <a href="/" class="flex items-center space-x-2 relative">
            <img src="/mandala2.svg" alt="Varaha Logo" class="w-10 h-10 object-contain scale-110 opacity-40 animate-spin animate-duration-1000" style="filter: brightness(0) invert(1) sepia(1) saturate(2) hue-rotate(15deg) brightness(1.2);" />
            <span class="text-2xl font-semibold text-white tracking-widest transform -translate-x-5">varaha<span class="text-brand-purple">.ai</span></span>
          </a>
          <div class="hidden md:flex space-x-6">
            <a href="/docs" class="text-gray-300 hover:text-white transition-colors">Docs</a>
            <a href="/pricing" class="text-gray-300 hover:text-white transition-colors">Pricing</a>
            <a href="/dashboard" class="text-gray-300 hover:text-white transition-colors">Dashboard</a>
          </div>
        </div>
        <div class="flex items-center space-x-4">
          <div class="flex items-center space-x-2">
            <span class="text-sm text-gray-300">{user?.name || 'Guest'}</span>
            {user ? (
              <a href="/settings" class="px-3 py-1 text-sm border border-white/20 rounded-lg hover:bg-white/10 transition-colors text-white">
                Settings
              </a>
            ) : (
              <>
                <a href="/login" class="px-3 py-1 text-sm border border-white/20 rounded-lg hover:bg-white/10 transition-colors text-white">
                  Login
                </a>
                <a href="/register" class="px-3 py-1 text-sm bg-gradient-to-r from-brand-purple to-brand-blue text-white rounded-lg hover:from-brand-purple/90 hover:to-brand-blue/90 transition-all">
                  Sign Up
                </a>
              </>
            )}
          </div>
        </div>
      </div>
    </div>
  </nav>

  <main class="py-8">
    <div class="container mx-auto px-4 max-w-4xl">
      <div class="mb-8">
        <h1 class="text-4xl font-bold text-white mb-4">Documentation</h1>
        <p class="text-xl text-gray-300">Complete guide to unlimited SLM inference with specialized task APIs</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        <aside class="md:col-span-1">
          <nav class="sticky top-8">
            <div class="glass p-4 rounded-lg backdrop-blur-md border border-white/10">
              <h3 class="font-semibold text-white mb-4">Table of Contents</h3>
              <ul class="space-y-2">
                <li><a href="#getting-started" class="text-brand-purple hover:underline">Getting Started</a></li>
                <li><a href="#api-reference" class="text-brand-purple hover:underline">API Reference</a></li>
                <li><a href="#tasks" class="text-brand-purple hover:underline">Available Tasks</a></li>
                <li><a href="#configuration" class="text-brand-purple hover:underline">Configuration</a></li>
                <li><a href="#monitoring" class="text-brand-purple hover:underline">Monitoring</a></li>
              </ul>
            </div>
          </nav>
        </aside>

        <div class="md:col-span-3 space-y-12">
          <section id="getting-started">
            <div class="glass p-6 rounded-lg backdrop-blur-md border border-white/10">
              <h2 class="text-2xl font-bold text-white mb-4">Getting Started</h2>
              <div class="prose prose-gray max-w-none">
                <p class="text-gray-300 mb-4">
                  Varaha is a production-ready SLM proxy designed for unlimited local inference and specialized task APIs. 
                  Perfect for indie developers looking to integrate AI into their day-to-day workloads.
                </p>
                
                <h3 class="text-lg font-semibold mb-2 text-white">Prerequisites</h3>
                <ul class="list-disc pl-6 space-y-1 text-gray-300">
                  <li>Hardware: M1/M2/M3 Mac with Metal acceleration</li>
                  <li>Local model files in the models/ directory</li>
                  <li>API key from your dashboard (for Pro features)</li>
                </ul>

                <h3 class="text-lg font-semibold mb-2 mt-4 text-white">Quick Start</h3>
                <pre class="bg-black/50 p-4 rounded-lg overflow-x-auto border border-white/10">
                  <code class="text-green-400">git clone https://github.com/your-repo/varaha
cd varaha
chmod +x start.sh
./start.sh</code>
                </pre>
              </div>
            </div>
          </section>

          <section id="api-reference">
            <div class="glass p-6 rounded-lg backdrop-blur-md border border-white/10">
              <h2 class="text-2xl font-bold text-white mb-4">API Reference</h2>
              <div class="prose prose-gray max-w-none">
                <h3 class="text-lg font-semibold mb-2 text-white">Execute a Task</h3>
                <p class="text-gray-300 mb-2">POST /v1/execute</p>
                <pre class="bg-black/50 p-4 rounded-lg overflow-x-auto border border-white/10">
                  <code class="text-green-400">{`{
  "task": "extract",
  "input": {
    "text": "Invoice #42 from Bob for $500",
    "schema": {"invoice": "number", "amount": "number"}
  },
  "config": {
    "compress": true
  }
}`}</code>
                </pre>

                <h3 class="text-lg font-semibold mb-2 mt-4 text-white">Check Performance Metrics</h3>
                <ul class="list-disc pl-6 space-y-1 text-gray-300">
                  <li>GET /v1/requests: List all processed job IDs</li>
                  <li>GET /v1/requests/{`{id}`}/metrics: Retrieve detailed latency and token benchmarks</li>
                </ul>
              </div>
            </div>
          </section>

          <section id="tasks">
            <div class="glass p-6 rounded-lg backdrop-blur-md border border-white/10">
              <h2 class="text-2xl font-bold text-white mb-4">Available Tasks</h2>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="glass p-4 rounded-lg backdrop-blur-md border border-white/10">
                  <h3 class="font-semibold mb-2 text-white">Summarization</h3>
                  <p class="text-sm text-gray-300">Condense long documents into key points</p>
                </div>
                <div class="glass p-4 rounded-lg backdrop-blur-md border border-white/10">
                  <h3 class="font-semibold mb-2 text-white">Data Extraction</h3>
                  <p class="text-sm text-gray-300">Extract structured data from unstructured text</p>
                </div>
                <div class="glass p-4 rounded-lg backdrop-blur-md border border-white/10">
                  <h3 class="font-semibold mb-2 text-white">Classification</h3>
                  <p class="text-sm text-gray-300">Categorize text into predefined classes</p>
                </div>
                <div class="glass p-4 rounded-lg backdrop-blur-md border border-white/10">
                  <h3 class="font-semibold mb-2 text-white">Content Rewriting</h3>
                  <p class="text-sm text-gray-300">Transform text while preserving meaning</p>
                </div>
                <div class="glass p-4 rounded-lg backdrop-blur-md border border-white/10">
                  <h3 class="font-semibold mb-2 text-white">Code Generation</h3>
                  <p class="text-sm text-gray-300">Generate code from natural language descriptions</p>
                </div>
                <div class="glass p-4 rounded-lg backdrop-blur-md border border-white/10">
                  <h3 class="font-semibold mb-2 text-white">Translation</h3>
                  <p class="text-sm text-gray-300">Translate text between multiple languages</p>
                </div>
              </div>
            </div>
          </section>

          <section id="configuration">
            <div class="glass p-6 rounded-lg backdrop-blur-md border border-white/10">
              <h2 class="text-2xl font-bold text-white mb-4">Configuration</h2>
              <div class="prose prose-gray max-w-none">
                <p class="text-gray-300 mb-4">
                  Varaha can be configured through environment variables and configuration files.
                </p>
                <h3 class="text-lg font-semibold mb-2 text-white">Environment Variables</h3>
                <ul class="list-disc pl-6 space-y-1 text-gray-300">
                  <li><code class="text-brand-purple">MODEL_PATH</code>: Path to your model files</li>
                  <li><code class="text-brand-purple">BATCH_SIZE</code>: Maximum batch size for processing</li>
                  <li><code class="text-brand-purple">MAX_TOKENS</code>: Maximum tokens per request</li>
                  <li><code class="text-brand-purple">COMPRESSION_ENABLED</code>: Enable prompt compression</li>
                </ul>
              </div>
            </div>
          </section>

          <section id="monitoring">
            <div class="glass p-6 rounded-lg backdrop-blur-md border border-white/10">
              <h2 class="text-2xl font-bold text-white mb-4">Monitoring</h2>
              <div class="prose prose-gray max-w-none">
                <p class="text-gray-300 mb-4">
                  Varaha includes built-in monitoring capabilities to track performance and usage.
                </p>
                <h3 class="text-lg font-semibold mb-2 text-white">Metrics Available</h3>
                <ul class="list-disc pl-6 space-y-1 text-gray-300">
                  <li>TTFT (Time To First Token)</li>
                  <li>Token counts per request</li>
                  <li>TPS (Tokens Per Second)</li>
                  <li>Batch processing efficiency</li>
                  <li>Error rates and types</li>
                </ul>
              </div>
            </div>
          </section>
        </div>
      </div>
    </div>
  </main>
</Layout>
