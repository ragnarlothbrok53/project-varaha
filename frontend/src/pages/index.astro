---
import Layout from '../layouts/Layout.astro'
import { authService } from '../lib/auth.ts'
import { Zap, Key, CreditCard } from 'lucide-astro'
const isAuthenticated = authService.isAuthenticated()
---

<Layout title="Varaha - Drop-in SLM Inference for Indie Devs">
  <nav class="border-b border-white/10 glass backdrop-blur-md">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex h-16 items-center justify-between">
        <div class="flex items-center space-x-8">
          <a href="/" class="flex items-center space-x-2 relative">
            <img src="/mandala2.svg" alt="Varaha Logo" class="w-10 h-10 object-contain scale-110 opacity-40 animate-spin animate-duration-1000" style="filter: brightness(0) invert(1) sepia(1) saturate(2) hue-rotate(15deg) brightness(1.2);" />
            <span class="text-2xl font-semibold text-white tracking-widest transform -translate-x-5">varaha<span class="text-brand-purple">.ai</span></span>
          </a>
          <div class="hidden md:flex space-x-6">
            <a href="/docs" class="text-gray-300 hover:text-white transition-colors">Docs</a>
            <a href="/pricing" class="text-gray-300 hover:text-white transition-colors">Pricing</a>
            <a href="/dashboard" class="text-gray-300 hover:text-white transition-colors">Dashboard</a>
          </div>
        </div>
        <div class="flex items-center space-x-4">
          <div class="flex items-center space-x-2">
            {isAuthenticated ? (
              <button 
                id="logoutBtn"
                class="px-3 py-1 text-sm border border-white/20 rounded-lg hover:bg-white/10 transition-colors text-white"
              >
                Logout
              </button>
            ) : (
              <a href="/login" class="px-5 py-2 text-sm font-semibold bg-gradient-to-r from-brand-purple to-brand-blue text-white rounded-lg hover:from-brand-purple/90 hover:to-brand-blue/90 shadow-[0_0_15px_rgba(139,92,246,0.5)] transition-all">
                Get Started
              </a>
            )}
          </div>
        </div>
      </div>
    </div>
  </nav>

  <main>
    <section class="py-24 px-4 overflow-hidden relative">
      <div class="container mx-auto grid lg:grid-cols-2 gap-12 items-center">
        <div class="text-left z-10">
          <div class="inline-flex items-center px-3 py-1 rounded-full border border-brand-purple/30 bg-brand-purple/10 text-brand-purple text-sm font-medium mb-6">
            <span class="w-2 h-2 rounded-full bg-brand-purple animate-pulse mr-2"></span>
            Zero setup. Fixed price.
          </div>
          <h1 class="text-5xl md:text-7xl font-bold text-white mb-6 leading-tight">
            Lightning-Fast <br/><span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-purple to-brand-blue">SLM Inference</span>
          </h1>
          <p class="text-xl text-gray-300 mb-8 max-w-xl leading-relaxed">
            Add production-ready AI to your app in seconds. We host specially tuned Small Language Models without the dev-ops headache or surprise AWS bills.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a 
              href="/login" 
              class="px-8 py-4 bg-white text-brand-dark font-bold rounded-lg hover:bg-gray-100 transition-all duration-200 shadow-lg text-center"
            >
              Start Building Now
            </a>
            <a 
              href="/pricing" 
              class="px-8 py-4 border border-white/20 rounded-lg hover:bg-white/10 transition-all duration-200 glass backdrop-blur-sm text-white text-center"
            >
              View Flat Pricing
            </a>
          </div>
        </div>

        <div class="relative z-10 w-full max-w-lg mx-auto lg:ml-auto">
          <div class="absolute -inset-1 blur-xl bg-gradient-to-r from-brand-purple to-brand-blue opacity-30 rounded-2xl"></div>
          <div class="glass-purple rounded-2xl p-4 shadow-2xl relative border border-white/20 font-mono text-sm">
            <div class="flex items-center gap-2 mb-4 px-2">
              <div class="w-3 h-3 rounded-full bg-red-500"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
              <div class="w-3 h-3 rounded-full bg-green-500"></div>
              <span class="ml-2 text-gray-400 text-xs">terminal</span>
            </div>
            <div class="space-y-4 text-gray-300 px-2 pb-2">
              <p class="text-brand-blue">$ curl -X POST https://api.varaha.ai/v1/chat/completions \</p>
              <p class="pl-4">  -H "Authorization: Bearer vk_live_summarizer" \</p>
              <p class="pl-4">  -d '&#123;"messages": [&#123;"role": "user", "content": "TLDR this article..."&#125;]&#125;'</p>
              <div class="mt-4 animate-pulse-slow">
                <p class="text-brand-purple opacity-70">></p>
                <p class="text-white">&#123;</p>
                <p class="pl-4">"id": "chatcmpl-a1b2c3d4",</p>
                <p class="pl-4 text-green-400">"content": "Varaha makes SLM tasks instant."</p>
                <p class="pl-4">"usage": &#123; "total": 42 &#125;</p>
                <p>&#125;</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 px-4 border-t border-white/5 bg-white/[0.02]">
      <div class="container mx-auto">
        <h2 class="text-3xl font-bold text-center text-white mb-16">Built for Indie Hackers & Mobile Devs</h2>
        <div class="grid md:grid-cols-3 gap-8">
          <div class="glass rounded-2xl p-8 backdrop-blur-md border border-white/10 hover:border-brand-purple/50 transition-colors">
            <div class="w-12 h-12 rounded-lg bg-brand-purple/20 flex items-center justify-center mb-6 text-brand-purple"><Zap class="w-6 h-6" /></div>
            <h3 class="text-xl font-bold text-white mb-3">Tuned for Speed</h3>
            <p class="text-gray-400 leading-relaxed">No bloat. We run optimized small language models (Qwen, Llama-Tiny) that return tokens instantly for fast app experiences.</p>
          </div>
          <div class="glass rounded-2xl p-8 backdrop-blur-md border border-white/10 hover:border-brand-blue/50 transition-colors">
            <div class="w-12 h-12 rounded-lg bg-brand-blue/20 flex items-center justify-center mb-6 text-brand-blue"><Key class="w-6 h-6" /></div>
            <h3 class="text-xl font-bold text-white mb-3">Intelligent API Keys</h3>
            <p class="text-gray-400 leading-relaxed">Embed system prompts, RAG data, and temperatures directly into your key. Ship cleaner frontend code with zero logic overhead.</p>
          </div>
          <div class="glass rounded-2xl p-8 backdrop-blur-md border border-white/10 hover:border-green-500/50 transition-colors">
            <div class="w-12 h-12 rounded-lg bg-green-500/20 flex items-center justify-center mb-6 text-green-500"><CreditCard class="w-6 h-6" /></div>
            <h3 class="text-xl font-bold text-white mb-3">Flat Rate Subscriptions</h3>
            <p class="text-gray-400 leading-relaxed">Stop calculating per-token GPU costs. Pay a single, predictable monthly fee for generous bounded requests.</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script>
    import { authService } from '../lib/auth.ts';
    
    if (document.getElementById('logoutBtn')) {
      document.getElementById('logoutBtn').addEventListener('click', () => {
        authService.logout();
        window.location.reload();
      });
    }
  </script>
</Layout>
