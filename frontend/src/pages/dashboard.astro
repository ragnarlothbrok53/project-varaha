---
import Layout from '../layouts/Layout.astro'
import { authService } from '../lib/auth.ts'
import { Key, Copy, Eye, BarChart3, Zap, Settings, X, Upload, Download } from 'lucide-astro'
const isAuthenticated = authService.isAuthenticated()
---

<Layout title="Dashboard - Varaha">
  <nav class="border-b border-white/10 glass backdrop-blur-md">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex h-16 items-center justify-between">
        <div class="flex items-center space-x-8">
          <a href="/" class="flex items-center space-x-2 relative">
            <img src="/mandala2.svg" alt="Varaha Logo" class="w-10 h-10 object-contain scale-110 opacity-40 animate-spin animate-duration-1000" style="filter: brightness(0) invert(1) sepia(1) saturate(2) hue-rotate(15deg) brightness(1.2);" />
            <span class="text-2xl font-semibold text-white tracking-widest transform -translate-x-5">varaha<span class="text-brand-purple">.ai</span></span>
          </a>
          <div class="hidden md:flex space-x-6">
            <a href="/docs" class="text-gray-300 hover:text-white transition-colors">Docs</a>
            <a href="/pricing" class="text-gray-300 hover:text-white transition-colors">Pricing</a>
            <a href="/dashboard" class="text-white font-medium">Dashboard</a>
            <a href="/api-test" class="text-gray-300 hover:text-white transition-colors">API Test</a>
          </div>
        </div>
        <div class="flex items-center space-x-4">
          <button 
            id="logoutBtn"
            class="px-4 py-2 text-sm border border-white/20 rounded-lg hover:bg-white/10 transition-colors text-white"
          >
            Logout
          </button>
        </div>
      </div>
    </div>
  </nav>

  <main class="py-12">
    <div class="container mx-auto px-4 max-w-6xl">
      <!-- Header Section -->
      <div class="flex flex-col md:flex-row md:items-center justify-between mb-8 pb-8 border-b border-white/10">
        <div>
          <h1 class="text-3xl font-bold text-white mb-2">Welcome Back</h1>
          <p class="text-gray-400">Manage your Intelligent API Keys and track SLM inference usage.</p>
        </div>
        <div class="mt-4 md:mt-0 flex gap-4">
          <div class="glass px-6 py-3 rounded-lg border border-white/10 text-center">
            <div class="text-sm text-gray-400 mb-1">Billing Tier</div>
            <div class="font-semibold text-green-400">Pro Fixed ($49/mo)</div>
          </div>
          <button class="px-6 py-3 bg-gradient-to-r from-brand-purple to-brand-blue text-white rounded-lg hover:from-brand-purple/90 hover:to-brand-blue/90 shadow-lg font-medium transition-all" onclick="document.getElementById('createKeyModal').classList.remove('hidden')">
            + Forge New Key
          </button>
        </div>
      </div>

      <!-- Keys Hub -->
      <div class="mb-12">
        <h2 class="text-xl font-semibold mb-6 text-white flex items-center">
          <span class="w-8 h-8 rounded bg-brand-purple/20 text-brand-purple flex items-center justify-center mr-3"><BarChart3 class="w-4 h-4" /></span>
          Your Active Keys
        </h2>
        
        <div id="keysGrid" class="grid gap-6">
          <div class="text-center py-8 text-gray-400">
            Fetching intelligent keys...
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- Create Key Modal Skeleton -->
  <div id="createKeyModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm">
    <div class="glass-purple rounded-2xl border border-white/10 w-full max-w-2xl overflow-hidden shadow-2xl">
      <div class="p-6 border-b border-white/10 flex justify-between items-center bg-white/5">
        <h2 class="text-xl font-bold text-white">Forge Intelligent Key</h2>
        <button class="text-gray-400 hover:text-white" onclick="document.getElementById('createKeyModal').classList.add('hidden')">✕</button>
      </div>
      <form id="createKeyForm" class="p-6 space-y-6">
        <div class="grid md:grid-cols-2 gap-6">
          <div>
            <label class="block text-sm text-gray-300 mb-2">Key Alias</label>
            <input type="text" id="keyName" placeholder="e.g. Grammar Checker App" class="w-full px-4 py-3 bg-black/30 border border-white/10 rounded-lg text-white focus:outline-none focus:ring-1 focus:ring-brand-purple" required>
          </div>
          <div>
            <label class="block text-sm text-gray-300 mb-2">Model Routing</label>
            <select id="keyModel" class="w-full px-4 py-3 bg-black/30 border border-white/10 rounded-lg text-white focus:outline-none focus:ring-1 focus:ring-brand-purple">
              <option value="qwen">Qwen 1.5B Turbo (Fast)</option>
              <option value="tinyllama">TinyLlama 1.1B Eco</option>
            </select>
          </div>
        </div>
        
        <div>
          <label class="block text-sm text-gray-300 mb-2">System Instructions</label>
          <textarea id="keySystem" rows="3" placeholder="Embed context like: 'You are a helpful assistant...'" class="w-full px-4 py-3 bg-black/30 border border-white/10 rounded-lg text-white focus:outline-none focus:ring-1 focus:ring-brand-purple"></textarea>
          <p class="text-xs text-gray-500 mt-2">These instructions are automatically prepended to every request using this key.</p>
        </div>
        
        <div>
          <div class="flex justify-between items-center mb-2">
            <label class="block text-sm text-gray-300">Temperature: <span id="tempVal">0.1</span></label>
          </div>
          <input type="range" id="keyTemp" min="0" max="1" step="0.1" value="0.1" class="w-full accent-brand-purple h-2 bg-black/30 rounded-lg appearance-none cursor-pointer" oninput="document.getElementById('tempVal').innerText = this.value">
        </div>

        <div id="formError" class="hidden text-red-400 text-sm"></div>

        <div class="pt-4 border-t border-white/10 flex justify-end gap-3">
          <button type="button" class="px-5 py-2.5 text-gray-300 hover:text-white transition-colors" onclick="document.getElementById('createKeyModal').classList.add('hidden')">Cancel</button>
          <button type="submit" id="submitKeyBtn" class="px-6 py-2.5 bg-gradient-to-r from-brand-purple to-brand-blue text-white rounded-lg shadow-lg font-medium hover:opacity-90">Generate Key</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    import { authService } from '../lib/auth.ts';
    
    // Auth Guard
    if (!authService.isAuthenticated()) {
      window.location.href = '/login';
    }

    if (document.getElementById('logoutBtn')) {
      document.getElementById('logoutBtn').addEventListener('click', () => {
        authService.logout();
        window.location.href = '/login';
      });
    }

    // Dynamic Rendering
    const keysGrid = document.getElementById('keysGrid');
    
    async function loadKeys() {
      try {
        const res = await authService.fetchWithAuth('http://localhost:8000/v1/admin/keys');
        if (res.ok) {
          const data = await res.json();
          renderKeys(data.keys);
        } else {
          keysGrid.innerHTML = `<div class="text-red-400 text-center py-8">Failed to load keys.</div>`;
        }
      } catch (err) {
        keysGrid.innerHTML = `<div class="text-red-400 text-center py-8">Connection error.</div>`;
      }
    }

    function renderKeys(keys) {
      if (!keys || keys.length === 0) {
        keysGrid.innerHTML = `<div class="text-center py-8 text-gray-400">No active keys. Create one to get started!</div>`;
        return;
      }
      
      keysGrid.innerHTML = keys.map(k => `
        <div class="glass-enhanced p-6 rounded-xl border border-white/10 hover:border-brand-purple/50 transition-all group">
          <div class="flex flex-col md:flex-row justify-between md:items-start gap-4 mb-4">
            <div>
              <div class="flex items-center gap-3 mb-1">
                <h3 class="text-lg font-bold text-white">${k.name}</h3>
                <span class="px-2 py-0.5 rounded text-xs bg-brand-purple/20 text-brand-purple border border-brand-purple/30">${k.model_id}</span>
              </div>
              <div class="text-sm font-mono text-gray-500 flex items-center gap-2">
                ${k.key} <button class="hover:text-white transition-colors" onclick="navigator.clipboard.writeText('${k.key}'); alert('Copied!')"><Copy class="w-4 h-4 inline" /></button>
              </div>
            </div>
            <div class="flex justify-end md:justify-start gap-4">
              <button class="px-4 py-1.5 glass rounded border border-white/10 text-sm text-gray-300 hover:text-white transition-colors flex items-center gap-2 min-w-[140px] overflow-hidden" onclick="showLogsModal('${k.key}')"><Eye class="w-4 h-4 flex-shrink-0" /> <span class="truncate">View Logs & Usage</span></button>
            </div>
          </div>
          
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-6 pt-6 border-t border-white/5">
            <div>
              <div class="text-xs text-gray-500 mb-1">System Prompt</div>
              <div class="text-sm text-gray-300 truncate" title="${k.system_prompt}">${k.system_prompt || "None"}</div>
            </div>
            <div>
              <div class="text-xs text-gray-500 mb-1">RAG Grounding</div>
              <div class="text-sm text-gray-300">${k.has_rag ? "Attached" : "None"}</div>
            </div>
            <div>
              <div class="text-xs text-gray-500 mb-1">Temperature</div>
              <div class="text-sm text-gray-300">${k.temperature}</div>
            </div>
            <div>
              <div class="text-xs text-gray-500 mb-1">Status</div>
              <div class="text-sm ${k.active ? 'text-green-400' : 'text-red-400'}">${k.active ? 'Active' : 'Inactive'}</div>
            </div>
          </div>
        </div>
      `).join('');
    }

    // Initial Load
    if (authService.isAuthenticated()) {
      loadKeys();
    }

    // Form submission
    const createForm = document.getElementById('createKeyForm');
    if (createForm) {
      createForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = document.getElementById('submitKeyBtn');
        const errDiv = document.getElementById('formError');
        
        btn.disabled = true;
        btn.textContent = 'Generating...';
        errDiv.classList.add('hidden');
        
        // Random UUID equivalent
        const keyVal = "vk_live_" + Math.random().toString(36).substring(2, 10) + Math.random().toString(36).substring(2, 10);
        
        const payload = {
          key: keyVal,
          name: document.getElementById('keyName').value,
          model_id: document.getElementById('keyModel').value,
          system_prompt: document.getElementById('keySystem').value,
          temperature: parseFloat(document.getElementById('keyTemp').value),
          files: []
        };
        
        try {
          const res = await authService.fetchWithAuth('http://localhost:8000/v1/admin/keys', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          
          if (res.ok) {
            document.getElementById('createKeyModal').classList.add('hidden');
            loadKeys();
            createForm.reset();
          } else {
            errDiv.textContent = 'Failed to create key. Ensure API is running.';
            errDiv.classList.remove('hidden');
          }
        } catch (error) {
          errDiv.textContent = 'Network error.';
          errDiv.classList.remove('hidden');
        } finally {
          btn.disabled = false;
          btn.textContent = 'Generate Key';
        }
      });
    }

    // Show Logs Modal
    async function showLogsModal(apiKey) {
      const modal = document.getElementById('logsModal');
      const content = document.getElementById('logsContent');
      
      modal.classList.remove('hidden');
      content.innerHTML = '<div class="text-center py-8 text-gray-400">Loading logs...</div>';
      
      try {
        const res = await authService.fetchWithAuth(`http://localhost:8000/v1/requests/key/${apiKey}`);
        if (res.ok) {
          const data = await res.json();
          displayLogs(data.requests, apiKey);
        } else {
          content.innerHTML = '<div class="text-center py-8 text-red-400">Failed to load logs.</div>';
        }
      } catch (err) {
        content.innerHTML = '<div class="text-center py-8 text-red-400">Connection error.</div>';
      }
    }

    // Display Logs
    function displayLogs(requests, apiKey) {
      const content = document.getElementById('logsContent');
      
      if (!requests || requests.length === 0) {
        content.innerHTML = `
          <div class="text-center py-8 text-gray-400">
            <div class="mb-4">No logs found for this API key.</div>
            <div class="text-sm">Make some requests using this key to see usage data.</div>
          </div>
        `;
        return;
      }

      // Calculate totals
      const totalTokens = requests.reduce((sum, r) => sum + (r.input_tokens || 0) + (r.output_tokens || 0), 0);
      const avgTTFT = requests.length > 0 
        ? (requests.reduce((sum, r) => sum + (r.ttft_ms || 0), 0) / requests.length).toFixed(2)
        : 0;
      const avgTPS = requests.length > 0
        ? (requests.reduce((sum, r) => sum + (r.tps || 0), 0) / requests.length).toFixed(2)
        : 0;

      content.innerHTML = `
        <!-- Summary Stats -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
          <div class="glass p-4 rounded-lg border border-white/10">
            <div class="text-sm text-gray-400 mb-1">Total Requests</div>
            <div class="text-2xl font-bold text-white">${requests.length}</div>
          </div>
          <div class="glass p-4 rounded-lg border border-white/10">
            <div class="text-sm text-gray-400 mb-1">Total Tokens</div>
            <div class="text-2xl font-bold text-brand-purple">${totalTokens}</div>
          </div>
          <div class="glass p-4 rounded-lg border border-white/10">
            <div class="text-sm text-gray-400 mb-1">Avg TTFT</div>
            <div class="text-2xl font-bold text-brand-blue">${avgTTFT}ms</div>
          </div>
          <div class="glass p-4 rounded-lg border border-white/10">
            <div class="text-sm text-gray-400 mb-1">Avg TPS</div>
            <div class="text-2xl font-bold text-green-400">${avgTPS}</div>
          </div>
        </div>

        <!-- Logs List -->
        <div class="space-y-3">
          <h3 class="text-lg font-semibold text-white mb-3">Recent Requests</h3>
          ${requests.map((req, index) => `
            <div class="glass p-4 rounded-lg border border-white/10">
              <div class="flex items-center justify-between mb-2">
                <div class="flex items-center gap-3">
                  <span class="text-sm font-medium text-white">Job ID: ${req.job_id.substring(0, 8)}...</span>
                  <span class="px-2 py-1 bg-brand-purple/20 text-brand-purple text-xs rounded">${req.model_id || 'qwen'}</span>
                </div>
                <div class="text-xs text-gray-400">
                  ${new Date(req.created_at).toLocaleString()}
                </div>
              </div>
              <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm mb-3">
                <div>
                  <div class="text-gray-400">TTFT</div>
                  <div class="text-white">${req.ttft_ms || 0}ms</div>
                </div>
                <div>
                  <div class="text-gray-400">TPS</div>
                  <div class="text-white">${req.tps || 0}</div>
                </div>
                <div>
                  <div class="text-gray-400">Input Tokens</div>
                  <div class="text-white">${req.input_tokens || 0}</div>
                </div>
                <div>
                  <div class="text-gray-400">Output Tokens</div>
                  <div class="text-white">${req.output_tokens || 0}</div>
                </div>
              </div>
              
              <!-- Expandable JSON sections -->
              <div class="space-y-2">
                ${req.request_payload && Object.keys(req.request_payload).length > 0 ? `
                  <div class="border border-white/10 rounded-lg overflow-hidden">
                    <button class="w-full px-3 py-2 bg-black/30 text-left text-sm text-gray-300 hover:bg-black/40 transition-colors flex justify-between items-center min-w-0" onclick="toggleJsonSection('input-${index}')">
                      <div class="flex items-center gap-2 flex-shrink-0">
                        <Upload class="w-4 h-4" />
                        <span class="whitespace-nowrap">Request JSON</span>
                      </div>
                      <span id="input-chevron-${index}" class="text-xs flex-shrink-0">▼</span>
                    </button>
                    <div id="input-${index}" class="hidden">
                      <div class="p-3 bg-black/20 border-t border-white/10 max-h-96 overflow-y-auto">
                        <pre class="text-xs text-gray-300 bg-black/40 p-2 rounded overflow-x-auto whitespace-pre-wrap break-all">${JSON.stringify(req.request_payload, null, 2)}</pre>
                      </div>
                    </div>
                  </div>
                ` : ''}
                
                ${req.response_json && Object.keys(req.response_json).length > 0 ? `
                  <div class="border border-white/10 rounded-lg overflow-hidden">
                    <button class="w-full px-3 py-2 bg-black/30 text-left text-sm text-gray-300 hover:bg-black/40 transition-colors flex justify-between items-center min-w-0" onclick="toggleJsonSection('output-${index}')">
                      <div class="flex items-center gap-2 flex-shrink-0">
                        <Download class="w-4 h-4" />
                        <span class="whitespace-nowrap">Response JSON</span>
                      </div>
                      <span id="output-chevron-${index}" class="text-xs flex-shrink-0">▼</span>
                    </button>
                    <div id="output-${index}" class="hidden">
                      <div class="p-3 bg-black/20 border-t border-white/10 max-h-96 overflow-y-auto">
                        <pre class="text-xs text-gray-300 bg-black/40 p-2 rounded overflow-x-auto whitespace-pre-wrap break-all">${JSON.stringify(req.response_json, null, 2)}</pre>
                      </div>
                    </div>
                  </div>
                ` : ''}
              </div>
            </div>
          `).join('')}
        </div>
      `;
    }

    // Toggle JSON section visibility
    function toggleJsonSection(sectionId) {
      const section = document.getElementById(sectionId);
      const chevronId = sectionId.replace('input-', 'input-chevron-').replace('output-', 'output-chevron-');
      const chevron = document.getElementById(chevronId);
      
      if (section.classList.contains('hidden')) {
        section.classList.remove('hidden');
        chevron.textContent = '▲';
      } else {
        section.classList.add('hidden');
        chevron.textContent = '▼';
      }
    }

    // Make functions globally accessible
    window.showLogsModal = showLogsModal;
    window.toggleJsonSection = toggleJsonSection;
  </script>

  <!-- Logs Modal -->
  <div id="logsModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm">
    <div class="glass-enhanced rounded-2xl border border-white/10 w-full max-w-4xl max-h-[80vh] overflow-hidden shadow-2xl">
      <div class="p-6 border-b border-white/10 flex justify-between items-center bg-white/5">
        <h2 class="text-xl font-bold text-white">API Logs & Usage</h2>
        <button class="text-gray-400 hover:text-white" onclick="document.getElementById('logsModal').classList.add('hidden')"><X class="w-5 h-5" /></button>
      </div>
      <div id="logsContent" class="p-6 overflow-y-auto max-h-[60vh] overscroll-contain">
        <div class="text-center py-8 text-gray-400">
          Loading logs...
        </div>
      </div>
    </div>
  </div>
</Layout>
